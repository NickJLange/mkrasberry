[Unit]
Description=Home Assistant Container
After=network-online.target
{% for path in container_required_paths | default([]) %}
AssertPathExists={{ path }}
{% endfor %}

[Container]
Image={{ image_name }}
ContainerName={{ container_friendly_name }}
EnvironmentFile={{ container_env_file }}
Network=host
Volume=/run/dbus/:/run/dbus/:ro
Volume={{ container_prefix }}/etc/:/config:Z,idmap
Volume={{ container_prefix }}/run:/run:Z,idmap
Volume=/etc/letsencrypt/:/ssl/:ro,Z
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
